#pragma once
#include <hip/hip_bf16.h>
#include <hip/hip_fp16.h>

#include <type_traits>

#include <flashinfer/rocm/attention/persistent.cuh>

using namespace flashinfer;

// gen_batch_attention_module (flashinfer/jit/rocm/modules.py) only renders
// matching 16-bit q / kv / o, an int32 index type and equal head dims.
using DTypeQ = {{ dtype_q }};
using DTypeKV = {{ dtype_kv }};
using DTypeO = {{ dtype_o }};
using IdType = {{ idtype }};
constexpr uint32_t HEAD_DIM_QK = {{ head_dim_qk }};
constexpr uint32_t HEAD_DIM_VO = {{ head_dim_vo }};
constexpr bool USE_LOGITS_SOFT_CAP = {{ use_logits_soft_cap }};

static_assert(std::is_same_v<DTypeQ, DTypeKV> && std::is_same_v<DTypeQ, DTypeO>,
              "BatchAttention on ROCm needs matching q, kv and o dtypes");
static_assert(std::is_same_v<IdType, int32_t>, "BatchAttention on ROCm needs int32 indices");
static_assert(HEAD_DIM_QK == HEAD_DIM_VO,
              "BatchAttention on ROCm needs head_dim_qk == head_dim_vo");

template <bool CAUSAL>
using BatchAttentionKernel =
    BatchAttentionPersistent<DTypeQ, HEAD_DIM_QK, CAUSAL, USE_LOGITS_SOFT_CAP>;
