# Source distribution contents.
#
# setuptools only ships Python packages and declared package-data by default, so
# anything outside flashinfer/ has to be named here.
#
# include/ is the source header tree. It is NOT under flashinfer/, and the
# generated flashinfer/include copy is deliberately absent from the sdist (see
# _prepare_for_sdist in build_backend_rocm.py) — building a wheel from this sdist
# re-creates it. Without this graft that wheel build would have no headers.
graft include

# The PEP 517 backend: pyproject.toml sets backend-path = ["."], so a build from
# this sdist imports build_backend_rocm. Upstream's build_backend.py ships too —
# unused here, but kept byte-identical so rebases do not conflict on it.
include build_backend.py
include build_backend_rocm.py

# Not used by the root backend: flashinfer-cubin and flashinfer-jit-cache
# import get_git_version from it at module load.
include build_utils.py

# setuptools-scm cannot derive a version outside a git checkout, so the
# generated version module has to travel with the tarball.
include flashinfer/_version.py

include LICENSE
include NOTICE
include README.md
recursive-include licenses *.txt

# csrc/rocm needs no graft: it is git-tracked at the repo root, and
# setuptools-scm's file finder adds every tracked file to the sdist. The wheel
# gets it from flashinfer/csrc/rocm, which build_backend_rocm.py materializes.

# setuptools-scm's file finder adds every git-tracked file to the sdist, so
# development and CI machinery has to be pruned explicitly or it ships in the
# release tarball. This list carries over the exclusions that
# [tool.scikit-build.sdist].exclude used to provide.
prune tests
prune docs
prune benchmarks
prune examples
prune 3rdparty
prune ci
prune docker
prune scripts
prune .github
prune .devcontainer
prune .claude
prune profiler
exclude Jenkinsfile
exclude CHANGELOG.md
global-exclude CLAUDE.md
exclude .clang-format
exclude .gitignore
exclude .gitmodules
exclude .pre-commit-config.yaml
