# syntax=docker/dockerfile:1.7
# ROCm development container for amd-flashinfer.
#
# The base image already provides ROCm 10.1, Python and a HIP build of PyTorch in
# the system interpreter, so this file adds only developer tooling and AITER.
#
# Three things that are NOT obvious and are load-bearing:
#
#  1. No conda/micromamba layer and no venv. Torch lives in the base image's
#     system interpreter, and another environment would shadow it.
#  2. /opt/rocm is a single symlink to the pip ROCm SDK's devel root, which on
#     ROCm 10.1 is a complete conventional root -- headers, lib/cmake, llvm/,
#     amdgcn/ and bin/amdclang++.
#  3. Nothing may `import aiter` at build time. It runs rocminfo for arch
#     detection *and* imports triton, which fails with
#     "0 active drivers ([]). There should only be one." when no GPU is attached,
#     and that has no env-var escape. Install it here; verify it at run time.
#     AITER's *builder* is reachable without that import, which is what lets the
#     variant prebuild below run here: aiter/setup.py:212 does
#     `sys.path.insert(0, ".../aiter/"); from jit import core`, a flat import
#     that never executes aiter/__init__.py. Do not "simplify" it to
#     `from aiter.jit import core` -- that runs the __init__ and needs a GPU.
#
# NOT torch 2.13: it drops c10::impl::cow::materialize_cow_storage, which every
# published amd-aiter build's prebuilt prefill kernels link against.
ARG BASE_IMAGE=rocm/pytorch:rocm10.1.0_ubuntu24.04_py3.12_pytorch_release_2.12.0
FROM ${BASE_IMAGE}

# AITER is built from source at a pinned tag, so it compiles against the ROCm in
# this image. No amd-aiter wheel targets ROCm 10: the index publishes
# 0.1.21.post2 only for ROCm 7.x, which here would be a silent wrong-ABI install.
ARG AITER_REF=v0.1.21.post2
ARG AITER_REPO=https://github.com/ROCm/aiter.git
# Both architectures in one fat binary. Must be explicit: there is no device here
# for AITER's arch detection to find. Note AITER's get_gfx() reads only the LAST
# entry, which gates -D__Float4_e2m1fn_x2; no attention source references it, so
# extending this prebuild to the quant or MoE ops needs that checked first.
ARG AITER_GPU_ARCHS="gfx942;gfx950"
ARG AITER_PREBUILD_JOBS=2

# Fail fast if the base stops shipping a HIP torch in its system interpreter: in a
# venv, root's installs below would land where the dev user's pip cannot write.
RUN python3 -c "import torch, sys; hip = torch.version.hip; print(f'torch {torch.__version__} (hip={hip})'); sys.exit('ERROR: installed torch has no ROCm/HIP build (hip is None)' if hip is None else 0)"
RUN python3 -c "import sys; sys.exit(f'ERROR: python3 is a venv ({sys.prefix}); the base must use its system interpreter' if sys.prefix != sys.base_prefix else 0)"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    clang-format \
    clangd-19 \
    curl \
    emacs \
    git \
    libstdc++-14-dev \
    python-is-python3 \
    sudo \
    tmux \
    vim \
    wget \
    zsh \
    && rm -rf /var/lib/apt/lists/*
# python-is-python3 points `python` at /usr/bin/python3; every documented command
# uses `python`, so after apt it must still be python3 and still hold HIP torch.
RUN python -c "import os, shutil, sys; p3 = shutil.which('python3'); sys.exit(0 if p3 and os.path.realpath(sys.executable) == os.path.realpath(p3) else f'ERROR: python is {sys.executable}, python3 is {p3}')" && \
    python -c "import sys, torch; sys.exit('ERROR: python has no HIP torch' if torch.version.hip is None else 0)"

# flashinfer resolves ROCm through ROCM_PATH/ROCM_HOME and invokes
# $ROCM_HOME/bin/amdclang++ by absolute path; hipcc finds its own clang under
# $ROCM_PATH/lib/llvm. The SDK devel root has all of it. Fail here, not at the
# first JIT compile, if a base stops shipping it or has another /opt/rocm.
RUN set -eu; \
    root="$(rocm-sdk path --root)"; \
    for p in bin/amdclang++ bin/hipcc lib/llvm/bin/clang++ lib/libamdhip64.so amdgcn \
             include/thrust/complex.h include/hipblaslt/hipblaslt.h share/hip/version; do \
        test -e "$root/$p" || { echo "ERROR: $root/$p missing" >&2; exit 1; }; \
    done; \
    if [ -e /opt/rocm ] || [ -L /opt/rocm ]; then \
        [ "$(readlink -f /opt/rocm)" = "$(readlink -f "$root")" ] || \
            { echo "ERROR: the base's /opt/rocm is not $root" >&2; exit 1; }; \
    else \
        ln -s "$root" /opt/rocm; \
    fi; \
    echo "[rocm] /opt/rocm -> $root"

ENV ROCM_PATH="/opt/rocm"
ENV ROCM_HOME="/opt/rocm"
ENV PATH="/opt/rocm/bin:/usr/lib/llvm-19/bin:$PATH"
# Appended, never assigned, so a base that sets these for torch's own libs is
# not clobbered. The SDK's libamdhip64 is the copy torch loads, not a second one.
ENV LIBRARY_PATH="${LIBRARY_PATH:+$LIBRARY_PATH:}/opt/rocm/lib"
ENV LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}/opt/rocm/lib"

ARG USERNAME=devuser
ARG USER_UID=1003
ARG USER_GID=$USER_UID

# Ubuntu ships a default `ubuntu` user and group at 1000, the most common host
# UID/GID, so both go before devuser is created. Anything else holding the UID
# fails here by name, not inside useradd.
RUN set -eu; \
    rm -rf /home/ubuntu; \
    if grep -q '^ubuntu:x:1000:1000:' /etc/passwd; then userdel -f -r ubuntu; fi; \
    squatter="$(getent passwd "$USER_UID" | cut -d: -f1 || true)"; \
    [ -z "$squatter" ] || { echo "ERROR: UID $USER_UID is already held by '$squatter'" >&2; exit 1; }

# Silence the warning about out-of-range UID/GID, then create the user.
RUN sed -i 's/^\(UID_MAX\s*\).*$/\11000000000/' /etc/login.defs && \
    sed -i 's/^\(GID_MAX\s*\).*$/\11000000000/' /etc/login.defs && \
    group="$(getent group $USER_GID | cut -d: -f1 || true)" && \
    if [ -z "$group" ]; then groupadd --gid $USER_GID $USERNAME; \
    elif [ $USER_GID -eq 0 ]; then echo "ERROR: USER_GID 0 is root" >&2; exit 1; \
    else echo "[user] primary group: existing '$group' (GID $USER_GID)"; fi && \
    useradd --uid $USER_UID --gid $USER_GID -m $USERNAME && \
    echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME && \
    chmod 0440 /etc/sudoers.d/$USERNAME

# /dev/dri/render* is render-owned on the hosts. Callers must still pass the
# host's numeric GIDs via --group-add, since the in-image ones will not match.
RUN set -eu; \
    for g in render video; do getent group "$g" >/dev/null || groupadd -r "$g"; done; \
    usermod -a -G render,video $USERNAME

RUN echo "set-option -g default-command \"/bin/bash -i\"" >> /home/$USERNAME/.tmux.conf

# The dev user's pip installs to --user; put its console scripts on PATH.
ENV PATH="/home/$USERNAME/.local/bin:$PATH"

# As root: with no venv, console scripts land in a root-owned /usr/local/bin.
# setuptools(-scm) serve the documented --no-build-isolation install (isolation
# pulls a non-ROCm torch from PyPI); <82 is this torch's own ceiling.
RUN pip install --no-cache-dir \
        ninja \
        "setuptools>=80,<82" \
        "setuptools-scm>=9.2" \
        "packaging>=24" \
        pre-commit \
        numpy \
        pytest pytest-cov pytest-xdist pytest-rerunfailures \
        pybind11 \
        ruff \
        einops \
        filelock

# Clone, install and delete in ONE layer. Splitting them would leave the clone
# (CK alone is over a GB) in the earlier layer, where a later `rm -rf` cannot
# reach it and the image carries it forever.
#
# Non-editable on purpose: `setup.py develop` takes an is_develop_mode() branch
# that sets packages = ["aiter"] with no aiter_meta, and aiter_meta/csrc/include
# is what every C++ shim compiles against. The non-editable install runs
# prepare_packaging(), which copies csrc and the CK tree into aiter_meta -- which
# is also what makes deleting the clone safe.
#
# PREBUILD_KERNELS=1 is unusable here: it rmtree's the jit dir and does
# `from aiter.aot.flydsl.common import run_aot`, a real `import aiter`. Its
# prebuilt modules are no loss -- FlashInfer links its own lib<module>.so built
# from these same sources, and measured, only aiter.mla loads one of AITER's.
#
# AITER_USE_SYSTEM_TRITON=1: above torch 2.9.1 aiter's setup.py otherwise
# replaces the image's triton with its own build, which on this base swaps
# torch's exact pin for a ROCm 7.2 triton and fails nothing.
RUN set -eu; \
    git clone --recursive --depth 1 --shallow-submodules \
        --branch "$AITER_REF" "$AITER_REPO" /var/tmp/aiter-src && \
    ( cd /var/tmp/aiter-src && \
      PREBUILD_KERNELS=0 GPU_ARCHS="$AITER_GPU_ARCHS" AITER_USE_SYSTEM_TRITON=1 \
      pip install --no-cache-dir --no-build-isolation . ) && \
    rm -rf /var/tmp/aiter-src

# Hard assertions, not prints. A shallow clone that lost its tag makes
# setuptools_scm invent a .dev version, which would fall under
# aiter_utils.AITER_MIN_VERSION and silently degrade every AITER path to fa2 --
# a working image that is quietly half as fast.
RUN python3 - <<'PY'
import importlib.metadata as md
import os
import sys
from pathlib import Path

got = md.version("amd-aiter")
ref = os.environ["AITER_REF"]
want = ref[1:] if ref.startswith("v") else ref
if got != want:
    sys.exit(f"ERROR: amd-aiter resolved to {got!r}, expected {want!r}")

FLOOR = "0.1.21"
from packaging.version import Version  # noqa: E402

if Version(got) < Version(FLOOR):
    sys.exit(f"ERROR: amd-aiter {got} is below AITER_MIN_VERSION {FLOOR}")

inc = Path(md.distribution("amd-aiter").locate_file("aiter_meta/csrc/include"))
if not inc.is_dir():
    sys.exit(f"ERROR: {inc} is missing; the shims cannot compile against this install")

import torch

if torch.version.hip is None:
    sys.exit("ERROR: the amd-aiter install replaced torch with a non-ROCm build")
print(f"amd-aiter {got}; torch {torch.__version__} (hip={torch.version.hip})")
PY

# Catches an installed dependency swapped for an incompatible build, which the
# version checks above cannot -- torch pins triton exactly and caps setuptools.
RUN python3 -m pip check

# AITER's JIT writes into its own aiter/jit, so the dev user gets the aiter
# trees' DIRECTORIES -- only those, so its pip still falls back to --user. Any
# other uid needs a writable HOME: AITER then copies its jit tree to ~/.aiter.
RUN set -eu; \
    purelib="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    find "$purelib/aiter" "$purelib/aiter_meta" -type d -exec chown $USER_UID:$USER_GID {} +
USER $USERNAME

# Placed after the install so editing the variant list re-runs only the prebuild.
COPY --chown=$USER_UID:$USER_GID docker/prebuild_aiter_attention.py /opt/prebuild_aiter_attention.py

# Compile the attention variants that the first request would otherwise compile
# in-process, under a process-global lock, minutes at a time. The driver ends in
# its own --check, so a missing or empty artifact fails the build here.
RUN set -eu; \
    export GPU_ARCHS="$AITER_GPU_ARCHS"; \
    JIT="$(python3 /opt/prebuild_aiter_attention.py --print-jit-dir)"; \
    case "$JIT" in \
      */site-packages/aiter/jit|*/dist-packages/aiter/jit) echo "prebuilding into $JIT" ;; \
      *) echo "ERROR: AITER resolves its jit dir to $JIT, not the installed tree;" \
         "a runtime container would look elsewhere and rebuild everything" >&2; \
         exit 1 ;; \
    esac; \
    python3 /opt/prebuild_aiter_attention.py --jobs "$AITER_PREBUILD_JOBS"

WORKDIR /home/$USERNAME

CMD ["/bin/bash"]
