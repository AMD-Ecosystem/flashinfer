# ROCm development container for amd-flashinfer.
#
# The base image already provides ROCm, Python and a HIP build of PyTorch inside
# a venv at /opt/venv, so this file adds only developer tooling and AITER.
#
# Two things that are NOT obvious and are load-bearing:
#
#  1. No conda/micromamba layer. Torch lives in the base image's interpreter, and
#     a separate conda environment would shadow it with a torch-less Python.
#     There is also no pip-installable torch for this ROCm release --
#     repo.radeon.com/rocm/manylinux/ publishes no rocm-rel-10.0/ -- so the
#     bundled torch is the only one available.
#  2. Nothing may `import aiter` at build time. It runs rocminfo for arch
#     detection *and* imports triton, which fails with
#     "0 active drivers ([]). There should only be one." when no GPU is attached,
#     and that has no env-var escape. Install it here; verify it at run time.
#     AITER's *builder* is reachable without that import, which is what lets the
#     variant prebuild below run here: aiter/setup.py:212 does
#     `sys.path.insert(0, ".../aiter/"); from jit import core`, a flat import
#     that never executes aiter/__init__.py. Do not "simplify" it to
#     `from aiter.jit import core` -- that runs the __init__ and needs a GPU.
ARG ROCM_VERSION=10.0
ARG UBUNTU_VERSION=24.04
ARG PY_VERSION=3.12
# NOT 2.13: it drops c10::impl::cow::materialize_cow_storage, which every
# published amd-aiter build's prebuilt prefill kernels link against.
ARG TORCH_VERSION=2.12.0

# Header donor. The rocm/pytorch base is runtime-only: it carries the pip ROCm
# SDK (_rocm_sdk_core) rather than /opt/rocm, and that SDK ships no math or
# utility headers -- no thrust, rocPRIM, rocBLAS or hipBLASLt. torch's complex.h
# needs thrust/complex.h, so the JIT cannot compile without them.
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION}.0-full AS rocmdev

FROM rocm/pytorch:rocm${ROCM_VERSION}_ubuntu${UBUNTU_VERSION}_py${PY_VERSION}_pytorch_release_${TORCH_VERSION}
ARG ROCM_VERSION
ARG PY_VERSION

# AITER is built from source at a pinned tag, so it compiles against the ROCm in
# this image rather than a retargeted wheel. AITER_SOURCE=0 restores the wheel
# install below for an unblock.
ARG AITER_SOURCE=1
ARG AITER_REF=v0.1.21.post2
ARG AITER_REPO=https://github.com/ROCm/aiter.git
# Both architectures in one fat binary. Must be explicit: there is no device here
# for AITER's arch detection to find.
ARG AITER_GPU_ARCHS="gfx942;gfx950"
ARG AITER_PREBUILD_JOBS=2

# The wheel path (AITER_SOURCE=0). Pinned to an exact build including the local
# version segment, because pip will not select a local version from a loose
# specifier. No +rocm10.0 build of amd-aiter exists; every 0.1.20 wheel shares
# source build id 3135022, so the +rocm10.1.0a one is the nearest retarget of the
# same revision.
ARG AITER_VERSION=0.1.20+rocm10.1.0a20260819.3135022
ARG AITER_INDEX=https://rocm.frameworks-nightlies.amd.com/whl-multi-arch/

# Fail fast if the base image ever stops shipping a HIP-enabled torch.
RUN python3 -c "import torch, sys; hip = torch.version.hip; print(f'torch {torch.__version__} (hip={hip})'); sys.exit('ERROR: installed torch has no ROCm/HIP build (hip is None)' if hip is None else 0)"

# System dependencies. libstdc++-14-dev and clangd-19 are both in noble, so these
# names -- and the /usr/lib/llvm-19/bin entry on PATH below -- carry over.
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang-format \
    clangd-19 \
    curl \
    emacs \
    git \
    libstdc++-14-dev \
    sudo \
    tmux \
    vim \
    wget \
    zsh \
    && rm -rf /var/lib/apt/lists/*

ARG USERNAME=devuser
ARG USER_UID=1003
ARG USER_GID=$USER_UID

# Ubuntu ships a default `ubuntu` user at UID/GID 1000, which is the most
# common host UID and what the README's $(id -u) yields -- so it has to go
# *before* devuser is created, or groupadd fails with "GID '1000' already
# exists" and the build dies here.
RUN rm -rf /home/ubuntu && \
    if grep -q '^ubuntu:x:1000:1000' /etc/passwd; then userdel -f -r ubuntu; fi

# Silence the warning about out-of-range UID/GID, then create the user.
RUN sed -i 's/^\(UID_MAX\s*\).*$/\11000000000/' /etc/login.defs && \
    sed -i 's/^\(GID_MAX\s*\).*$/\11000000000/' /etc/login.defs && \
    groupadd --gid $USER_GID $USERNAME && \
    useradd --uid $USER_UID --gid $USER_GID -m $USERNAME && \
    echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME && \
    chmod 0440 /etc/sudoers.d/$USERNAME

# The base image has a `video` group but no `render` group, while /dev/dri/render*
# is render-owned on the hosts. Create it so the user can be a member; callers
# must still pass the host's numeric render GID via --group-add, since the
# in-image GID will not generally match the host's.
RUN (getent group render >/dev/null || groupadd -r render) && \
    usermod -a -G render,video $USERNAME

RUN echo "set-option -g default-command \"/bin/bash -i\"" >> /home/$USERNAME/.tmux.conf

# The system python is PEP 668 externally-managed, so everything goes into the
# base image's existing venv -- that is where torch already lives, and creating a
# second one would hide it.
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:/usr/lib/llvm-19/bin:$PATH"

# Close the three gaps between the pip ROCm SDK and a /opt/rocm install, without
# which every JIT compile dies on `/opt/rocm/bin/amdclang++: not found`.
ENV ROCM_SDK="/opt/venv/lib/python${PY_VERSION}/site-packages/_rocm_sdk_core"
COPY --from=rocmdev /opt/rocm/core-${ROCM_VERSION}/include /opt/rocm-headers/include

#  1. Headers, from the donor stage above.
ENV CPATH="/opt/rocm-headers/include${CPATH:+:$CPATH}"
#  2. Link names: the SDK ships only versioned libs (libamdhip64.so.7), so
#     -lamdhip64 cannot resolve without an unversioned symlink.
#  3. Compiler name: flashinfer invokes $ROCM_HOME/bin/amdclang++, and the SDK
#     ships bin/hipcc plus lib/llvm/bin/clang++ under a different name. The
#     device bitcode also sits at lib/llvm/amdgcn rather than $ROCM_PATH/amdgcn.
RUN set -eu; \
    for so in "$ROCM_SDK"/lib/lib*.so.[0-9]*; do \
        [ -e "$so" ] || continue; \
        base="${so%%.so.*}.so"; [ -e "$base" ] || ln -s "$(basename "$so")" "$base"; \
    done; \
    ln -sf ../lib/llvm/bin/clang++ "$ROCM_SDK/bin/amdclang++"; \
    ln -sf ../lib/llvm/bin/clang "$ROCM_SDK/bin/amdclang"; \
    [ -e "$ROCM_SDK/amdgcn" ] || ln -s lib/llvm/amdgcn "$ROCM_SDK/amdgcn"

# Point at the SDK root, NOT at the grafted header tree: hipcc resolves its own
# clang via $ROCM_PATH/lib/llvm/bin, which only exists under the SDK.
ENV ROCM_PATH="$ROCM_SDK"
ENV ROCM_HOME="$ROCM_SDK"
# Appended rather than assigned so a future base image that sets these for
# torch's own bundled ROCm libs is not clobbered. Today's base sets none of them.
ENV LIBRARY_PATH="${LIBRARY_PATH:+$LIBRARY_PATH:}$ROCM_SDK/lib"
ENV LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$ROCM_SDK/lib"

# Hand over the venv *directories* only, then install as the dev user so every
# package added below is owned by them. A recursive chown would instead copy the
# base image's whole 19 GB venv into a new layer.
RUN find "$VIRTUAL_ENV" -type d -exec chown $USER_UID:$USER_GID {} +
USER $USERNAME

# setuptools and setuptools-scm are the in-tree backend's build requirements.
# They must be in the image because the documented install passes
# --no-build-isolation, which is itself required: isolation resolves torch from
# PyPI and pulls a non-ROCm wheel. The torch check repeats after AITER for the
# same reason -- --extra-index-url leaves PyPI visible, so a dependency of the
# AITER wheel can swap in a CPU-only torch and the build still exits 0.
# Its own layer, so bumping AITER below does not reinstall all of this.
RUN pip install --no-cache-dir \
        ninja \
        "setuptools>=80" \
        "setuptools-scm>=9.2" \
        "packaging>=24" \
        pre-commit \
        numpy \
        pytest pytest-cov pytest-xdist pytest-rerunfailures \
        pybind11 \
        ruff \
        einops \
        filelock

# Clone, install and delete in ONE layer. Splitting them would leave the clone
# (CK alone is over a GB) in the earlier layer, where a later `rm -rf` cannot
# reach it and the image carries it forever.
#
# Non-editable on purpose: `setup.py develop` takes an is_develop_mode() branch
# that sets packages = ["aiter"] with no aiter_meta, and aiter_meta/csrc/include
# is what every C++ shim compiles against. The non-editable install runs
# prepare_packaging(), which copies csrc and the CK tree into aiter_meta -- which
# is also what makes deleting the clone safe.
#
# PREBUILD_KERNELS=1 is unusable here: it rmtree's the jit dir and does
# `from aiter.aot.flydsl.common import run_aot`, a real `import aiter`. Its
# prebuilt modules are no loss -- FlashInfer links its own lib<module>.so built
# from these same sources, and measured, only aiter.mla loads one of AITER's.
RUN set -eu; \
    if [ "$AITER_SOURCE" = "1" ]; then \
        git clone --recursive --depth 1 --shallow-submodules \
            --branch "$AITER_REF" "$AITER_REPO" /tmp/aiter && \
        ( cd /tmp/aiter && \
          PREBUILD_KERNELS=0 GPU_ARCHS="$AITER_GPU_ARCHS" \
          pip install --no-cache-dir --no-build-isolation . ) && \
        rm -rf /tmp/aiter; \
    else \
        pip install --no-cache-dir "amd-aiter==${AITER_VERSION}" \
            --extra-index-url "${AITER_INDEX}"; \
    fi

# Hard assertions, not prints. A shallow clone that lost its tag makes
# setuptools_scm invent a .dev version, which would fall under
# aiter_utils.AITER_MIN_VERSION and silently degrade every AITER path to fa2 --
# a working image that is quietly half as fast. The torch check repeats here
# because --extra-index-url leaves PyPI visible, so a dependency can swap in a
# CPU-only torch and the build still exits 0.
RUN python3 - <<'PY'
import importlib.metadata as md
import os
import sys
from pathlib import Path

got = md.version("amd-aiter")
ref, version = os.environ["AITER_REF"], os.environ["AITER_VERSION"]
want = ref[1:] if ref.startswith("v") else ref
want = want if os.environ["AITER_SOURCE"] == "1" else version
if got != want:
    sys.exit(f"ERROR: amd-aiter resolved to {got!r}, expected {want!r}")

inc = Path(md.distribution("amd-aiter").locate_file("aiter_meta/csrc/include"))
if not inc.is_dir():
    sys.exit(f"ERROR: {inc} is missing; the shims cannot compile against this install")

import torch

if torch.version.hip is None:
    sys.exit("ERROR: the amd-aiter install replaced torch with a non-ROCm build")
print(f"amd-aiter {got}; torch {torch.__version__} (hip={torch.version.hip})")
PY

# Placed after the install so editing the variant list re-runs only the prebuild.
COPY --chown=$USER_UID:$USER_GID docker/prebuild_aiter_attention.py /opt/prebuild_aiter_attention.py

# Compile the attention variants that the first request would otherwise compile
# in-process, under a process-global lock, minutes at a time. The driver ends in
# its own --check, so a missing or empty artifact fails the build here.
RUN set -eu; \
    GPU_ARCHS="$AITER_GPU_ARCHS" \
    python3 /opt/prebuild_aiter_attention.py --jobs "$AITER_PREBUILD_JOBS"

WORKDIR /home/$USERNAME

CMD ["/bin/bash"]
